{
    "name": "splitice/php-x4b-api",
    "description": "PHP client library for the X4B.NET API v2.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "x4b",
        "api"
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phan/phan": "^6.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Splitice\\X4B\\": "src/Splitice/X4B/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit --configuration phpunit.xml.dist",
        "phplint": "@php tools/phplint.php src tests",
        "phpstan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --debug",
        "phan": "vendor/bin/phan --allow-polyfill-parser --no-progress-bar",
        "ci": [
            "@composer validate --strict",
            "@composer phplint",
            "@composer phpstan",
            "@composer phan",
            "@composer test"
        ]
    }
}
